@page "/roles"
@using Client.DummyTests
@using Client.Models
@using Client.Services
@using HandyBlazorComponents.Models
@using static HandyBlazorComponents.Models.ServiceResponses
@attribute [Authorize(Roles = Shared.Constants.ADMIN)]

<div class="text-center m-5">
    <h2><b>All Roles</b></h2>
</div>
<hr />
<div class="text-center overflow-auto m-3">
    @if (doneLoadingLst)
    {
        <CascadingValue Name="HandyGridState" Value="rolesGridStateService" IsFixed="true">
            <DynamicHandyGrid TItem="RoleDTO" TEntity="RolesGridEntity" Items="Items"/>
        </CascadingValue>
    }
    else
    {
        <div class="d-flex justify-content-center">
            <div id="loadingIndicator" class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
</div>

<HandyToast @ref="handyToast" Title="Success" Message="Your operation completed successfully."
    ToastType="HandyToastType.SUCCESS" Duration="5" />

@code {
    private bool doneLoadingLst = false;
    private HttpClient httpClient { get; set; }
    private RolesGridStateService rolesGridStateService = default!;
    private HandyToast handyToast = default!;
    List<RolesGridEntity> Items = [];


    protected override async Task OnInitializedAsync()
    {
        httpClient = httpClientFactory.CreateClient(Constants.HTTP_CLIENT);
        Items = (await
        httpClient.GetFromJsonAsync<IEnumerable<RoleDTO>>("api/Roles/get-roles")).Select(p => new RolesGridEntity(Object: p)).OrderBy(p => p.Object.Id).ToList();
        rolesGridStateService = new(
        Items: Items,
        ReadonlyColumns: [nameof(RoleDTO.Id)],
        ColumnsToHide: [nameof(RoleDTO.Id)],
        IsReadonly: false,
        EditModeFragments: [
        new NamedRenderFragment<RolesGridEntity>(
            Name: nameof(RoleDTO.IsActive),
            Fragment: o => @<HandyCheckbox TItem="RoleDTO" Item="o.Object" ColumnName="@(nameof(RoleDTO.IsActive))" />),
        ],
        ViewModeFragments: [
        new NamedRenderFragment<RolesGridEntity>(
            Name: nameof(RoleDTO.IsActive),
            Fragment: o => @<input type="checkbox" @bind="o.Object.IsActive" disabled="disabled">),
        ],
        OnCreate: async (items) =>
        {
            var list = items.ToList();

            // apply changes here to db in real-world scenario as well
            var response = await httpClient.PostAsJsonAsync("api/Roles/add-roles", list.Select(e => e.Object));

            var responseContents = await response.Content.ReadFromJsonAsync<IEnumerable<GeneralResponse>>();

            foreach (var responseContent in responseContents)
            {
                if (!responseContent.Flag)
                {
                    _ = handyToast.ShowToastAsync("Error", responseContent.Message, HandyToastType.ERROR);
                }
                else
                {
                    _ = handyToast.ShowToastAsync("Success", responseContent.Message, HandyToastType.SUCCESS);
                    // NavigationManager.NavigateTo("/roles", forceLoad: true);
                }
            }

            NavigationManager.NavigateTo("/roles", forceLoad: true);
        },
        OnDelete: async (item) =>
        {
            // TODO: change get primary key to object type instead of int
            var val = Items.FirstOrDefault(i => i.Object.RoleName == item.Object.RoleName);
            var response = await httpClient.DeleteAsync($"api/Roles/delete-role/{item.Object.Id}");
            var responseContent = await response.Content.ReadFromJsonAsync<GeneralResponse>();
            if (!responseContent.Flag)
            {
                _ = handyToast.ShowToastAsync("Error", responseContent.Message, HandyToastType.ERROR);
            }
            else
            {
                Items.Remove(val);
                _ = handyToast.ShowToastAsync("Success", responseContent.Message, HandyToastType.SUCCESS);
                //NavigationManager.NavigateTo("/roles", forceLoad: true);
            }
        },
        OnUpdate: async (item) =>
        {
            var response = await httpClient.PatchAsJsonAsync("api/Roles/edit-role", item.Object);
            var responseContent = await response.Content.ReadFromJsonAsync<GeneralResponse>();
            if (!responseContent.Flag)
            {
                _ = handyToast.ShowToastAsync("Error", responseContent.Message, HandyToastType.ERROR);
            }
            else
            {
                await handyToast.ShowToastAsync("Success", responseContent.Message, HandyToastType.SUCCESS);
                NavigationManager.NavigateTo("/roles", forceLoad: true);
            }
        });

        doneLoadingLst = true;

        var authState = await ((ApiAuthenticationStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();
        var user = authState.User;

        //userId = Convert.ToInt32(user.Claims.First(c => c.Type == ClaimTypes.NameIdentifier).Value);
    }



}