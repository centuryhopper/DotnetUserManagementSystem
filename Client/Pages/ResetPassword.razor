@page "/reset-password"

@using HandyBlazorComponents.Models
@inject IAccountService accountService


<h2>Reset Password</h2>
<hr />
<div class="row">
    <div class="col-md-12">
        <EditForm Model="@dto" OnValidSubmit="HandleSubmit">
            <div class="card">
                <h4 class="card-header"></h4>
                <div class="card-body">
                    <DataAnnotationsValidator />
                    <p class="form-group">
                        <label for="Password">Password</label>
                        <InputText id="Password" class="form-control" @bind-Value="dto.Password" aria-placeholder="Enter your Password"/>
                        <ValidationMessage For="@(() => dto.Password)" />
                    </p>
                    <p class="form-group">
                        <label for="ConfirmPasswsord">Confirm Passwsord</label>
                        <InputText id="ConfirmPasswsord" class="form-control" @bind-Value="dto.ConfirmPassword" aria-placeholder="Confirm your Passwsord"/>
                        <ValidationMessage For="@(() => dto.ConfirmPassword)" />
                    </p>
                </div>
            </div>
            <div class="m-3">
                <p class="m-3">
                    <button disabled="@loading" class="btn btn-primary">
                        @if (loading)
                        {
                            <span class="spinner-border spinner-border-sm mr-1"></span>
                        }
                        Reset Password
                    </button>
                    @if (!string.IsNullOrWhiteSpace(errMsg))
                    {
                        <p class="text-danger m-3">
                            @errMsg
                        </p>
                    }
                </p>
            </div>
        </EditForm>
    </div>
</div>

<CooldownTimer @ref="cooldownTimer" CooldownTime="30" MaxAttempts="5" OnCooldownComplete="OnCooldownComplete" />

<HandyToast @ref="handyToast" Title="Success" Message="Your operation completed successfully."
    ToastType="HandyToastType.SUCCESS" Duration="5" />

@code {
    private HandyToast handyToast = default!;
    private CooldownTimer cooldownTimer = default!;
    private ResetPasswordDTO dto = new();
    private bool loading = false;

    [SupplyParameterFromQuery]
    public string email {get;set;}
    [SupplyParameterFromQuery]
    public string token {get;set;}

    private string errMsg = "";

    private void OnCooldownComplete()
    {
        StateHasChanged();
    }

    protected override void OnInitialized()
    {
        dto.Email = email;
        dto.Token = token;
    }

    private async Task HandleSubmit()
    {
        if (cooldownTimer.IsCoolingDown)
        {
            errMsg = "";
            return;
        }

        loading = true;
        errMsg = ""; // Clear any previous error messages


        // Handle login logic here
        //Console.WriteLine("showing modal");
        var response = await accountService.ResetPasswordAsync(dto);
        loading = false;
        if (!response.Flag)
        {
            cooldownTimer.IncrementSubmissionCount();
            //notificationModal.Show("Error", response.Message, ModalType.ERROR);
            //Console.WriteLine(response.Message);
            if (!cooldownTimer.IsCoolingDown)
            {
                errMsg = response.Message;
            }
            return;
        }

        dto = new();
        
        _ = handyToast.ShowToastAsync("Success", response.Message, HandyToastType.SUCCESS);
    }
    private async Task HandleErrors()
    {
        Console.WriteLine("error!");
    }
}