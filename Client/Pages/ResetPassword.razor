@page "/reset-password"
@using Client.Components

@inject IAccountService accountService


<h2>Reset Password</h2>
<hr />
<div class="row">
    <div class="col-md-12">
        <EditForm Model="@dto" OnValidSubmit="HandleSubmit">
            <div class="card">
                <h4 class="card-header"></h4>
                <div class="card-body">
                    <DataAnnotationsValidator />
                    <p class="form-group">
                        <label for="Password">Password</label>
                        <InputText id="Password" class="form-control" @bind-Value="dto.Password" aria-placeholder="Enter your Password"/>
                        <ValidationMessage For="@(() => dto.Password)" />
                    </p>
                    <p class="form-group">
                        <label for="ConfirmPasswsord">Confirm Passwsord</label>
                        <InputText id="ConfirmPasswsord" class="form-control" @bind-Value="dto.ConfirmPassword" aria-placeholder="Confirm your Passwsord"/>
                        <ValidationMessage For="@(() => dto.ConfirmPassword)" />
                    </p>
                </div>
            </div>
            <div class="m-3">
                <p class="m-3">
                    <button disabled="@loading" class="btn btn-primary">
                        @if (loading)
                        {
                            <span class="spinner-border spinner-border-sm mr-1"></span>
                        }
                        Reset Password
                    </button>
                    <CoolDownMessageDisplay />
                </p>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private ResetPasswordDTO dto = new();
    private bool loading = false;

    [SupplyParameterFromQuery]
    public string email {get;set;}
    [SupplyParameterFromQuery]
    public string token {get;set;}

    private void OnCooldownComplete()
    {
        StateHasChanged();
    }

    protected override void OnInitialized()
    {
        dto.Email = email;
        dto.Token = token;
    }

    private async Task HandleSubmit()
    {
        loading = true;

        // Handle login logic here
        //Console.WriteLine("showing modal");
        var response = await accountService.ResetPasswordAsync(dto);
        loading = false;
        if (!response.Flag)
        {
            await jsRuntime.InvokeVoidAsync("cooldown.generateAttemptsNotice");
            await toastService.Error("Error", response.Message);
            return;
        }

        dto = new();
        
        await toastService.Success("Success", response.Message);
    }
}