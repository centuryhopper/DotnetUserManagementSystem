@page "/forgot-password"
@using Client.Components

@inject IAccountService accountService


<h2>Forgot Password</h2>
<hr />
<div class="row">
    <div class="col-md-12">
        <EditForm Model="@dto" OnValidSubmit="HandleSubmit">
            <div class="card">
                <h4 class="card-header"></h4>
                <div class="card-body">
                    <DataAnnotationsValidator />
                    <p class="form-group">
                        <label for="email">Email</label>
                        <InputText id="email" class="form-control" @bind-Value="dto.Email" aria-placeholder="Enter your email"/>
                        <ValidationMessage For="@(() => dto.Email)" />
                    </p>
                </div>
            </div>
            <div class="m-3">
                <p class="m-3">
                    <button disabled="@loading" class="btn btn-primary">
                        @if (loading)
                        {
                            <span class="spinner-border spinner-border-sm mr-1"></span>
                        }
                        Submit
                    </button>
                    <CoolDownMessageDisplay />
                </p>
            </div>
        </EditForm>
    </div>
</div>


@code {
    private ForgotPasswordDTO dto = new();
    private bool loading = false;
    
    private async Task HandleSubmit()
    {
        loading = true;
        var response = await accountService.ForgotPasswordAsync(dto);
        loading = false;
        if (!response.Flag)
        {
            await jsRuntime.InvokeVoidAsync("cooldown.generateAttemptsNotice");
            await toastService.Error("Error", response.Message);
            return;
        }
        
        await toastService.Success("Success", response.Message);
    }
}