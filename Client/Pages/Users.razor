@page "/users"
@using System.Reflection
@using Client.Services
@using Radzen
@using Radzen.Blazor
@attribute [Authorize(Roles = Shared.Constants.ADMIN)]

<div class="text-center m-5">
    <h2><b>All Users</b></h2>
</div>
<hr />
<div class="m-3">
    @if (doneLoadingLst)
    {
        <RadzenDataGrid TItem="UserDTO" Data="@users" AllowPaging="true" PageSize="5" AllowSorting="true">
            <Columns>
                @* One column per UserDTO property (except Id), like DynamicHandyGrid did *@
                @foreach (var prop in columns)
                {
                    var isList = IsCollection(prop.PropertyType);

                    <RadzenDataGridColumn @key="prop.Name" Property="@prop.Name" Title="@prop.Name" Sortable="@(!isList)"
                                          Filterable="@(!isList)">
                        <Template Context="user">
                            @if (isList)
                            {
                                @string.Join(", ", ((System.Collections.IEnumerable?)prop.GetValue(user) ??
                                    Array.Empty<object>()).Cast<object>())
                            }
                            else
                            {
                                @prop.GetValue(user)
                            }
                        </Template>
                    </RadzenDataGridColumn>
                }
            </Columns>
        </RadzenDataGrid>
    }
    else
    {
        <div class="d-flex justify-content-center">
            <div id="loadingIndicator" class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
</div>


@code {
    private bool doneLoadingLst = false;
    private HttpClient httpClient { get; set; } = default!;
    private List<UserDTO> users = [];

    private static readonly string[] hiddenColumns = [nameof(UserDTO.Id)];

    private static readonly List<PropertyInfo> columns = typeof(UserDTO)
        .GetProperties(BindingFlags.Public | BindingFlags.Instance)
        .Where(p => !hiddenColumns.Contains(p.Name))
        .ToList();

    // true for List<string>, string[], etc. (but not string, which is also IEnumerable)
    private static bool IsCollection(Type t) =>
        t != typeof(string) && typeof(System.Collections.IEnumerable).IsAssignableFrom(t);
    
    protected override async Task OnInitializedAsync()
    {
        httpClient = httpClientFactory.CreateClient(Constants.HTTP_CLIENT);

        users = ((await httpClient.GetFromJsonAsync<List<UserDTO>>("api/Users/get-users")) ?? [])
            .OrderBy(u => u.Id)
            .ToList();

        doneLoadingLst = true;
    }
}