@page "/edit-profile"

@using HandyBlazorComponents.Models
@using Microsoft.AspNetCore.Components.Forms
@inject IAccountService accountService
@inject NavigationManager NavigationManager

<div class="container-fluid">
    <EditForm Model="@dto" OnValidSubmit="HandleSubmit">
        <div class="card">
            <h4 class="card-header">Edit Your Profile</h4>
            <div class="card-body">
                <DataAnnotationsValidator />
                <p class="form-group">
                    <label for="CurrentEmail">Current Email</label>
                    <InputText id="CurrentEmail" class="form-control" @bind-Value="dto.CurrentEmail" aria-placeholder="Current Email"/>
                    <ValidationMessage For="@(() => dto.CurrentEmail)" />
                </p>
                <p class="form-group">
                    <label for="CurrentPassword">Current Password</label>
                    <div class="input-group" id="show_hide_password">
                        <InputText id="CurrentPassword" class="form-control" @bind-Value="dto.CurrentPassword" type="@currentPasswordType" aria-placeholder="Current Password" />
                        <div class="input-group-append">
                            <div class="input-group-addon">
                                <span class="input-group-text">
                                    <a 
                                    @onclick="@((m)=> ToggleCurrentPasswordVisibility(m))"@onkeypress="ToggleCurrentPasswordVisibility" @onkeypress:preventDefault="true" tabindex="0" style="color: black; cursor: pointer;">
                                        <i class="fa @currentPasswordIconClass field-icon m-1" aria-hidden="true"></i></a>
                                </span>
                            </div>
                        </div>
                    </div>
                    <ValidationMessage For="@(() => dto.CurrentPassword)" />
                </p>

                <p class="form-group">
                    <label for="NewPassword">New Password</label>
                    <div class="input-group" id="show_hide_password">
                        <InputText id="NewPassword" class="form-control" @bind-Value="dto.NewPassword" type="@newPasswordType" aria-placeholder="New Password" />
                        <div class="input-group-append">
                            <div class="input-group-addon">
                                <span class="input-group-text">
                                    <a 
                                    @onclick="@((m)=> ToggleNewPasswordVisibility(m))"@onkeypress="ToggleNewPasswordVisibility" @onkeypress:preventDefault="true" tabindex="0" style="color: black; cursor: pointer;">
                                        <i class="fa @newPasswordIconClass field-icon m-1" aria-hidden="true"></i></a>
                                </span>
                            </div>
                        </div>
                    </div>
                    <ValidationMessage For="@(() => dto.NewPassword)" />
                </p>

                <p class="form-group">
                    <label for="ConfirmPassword">Confirm Password</label>
                    <div class="input-group" id="show_hide_password">
                        <InputText id="ConfirmPassword" class="form-control" @bind-Value="dto.ConfirmPassword" type="@newPasswordType" />
                        <div class="input-group-append">
                            <div class="input-group-addon">
                                <span class="input-group-text">
                                    <a 
                                    @onclick="@((m)=> ToggleNewPasswordVisibility(m))"@onkeypress="ToggleNewPasswordVisibility" @onkeypress:preventDefault="true" tabindex="0" style="color: black; cursor: pointer;">
                                        <i class="fa @newPasswordIconClass field-icon m-1" aria-hidden="true"></i></a>
                                </span>
                            </div>
                        </div>
                    </div>
                    <ValidationMessage For="@(() => dto.ConfirmPassword)" />
                </p>
            </div>
        </div>
        <div class="m-3">
            <p class="m-3">
                <button disabled="@loading" class="btn btn-primary">
                    @if (loading)
                    {
                        <span class="spinner-border spinner-border-sm mr-1"></span>
                    }
                    Update Profile
                </button>
                @if (!string.IsNullOrWhiteSpace(errMsg))
                {
                    <p class="text-danger m-3">
                        @errMsg
                    </p>
                }
            </p>
        </div>
    </EditForm>
</div>


<NotificationModal @ref="notificationModal" />
<CooldownTimer @ref="cooldownTimer" CooldownTime="30" MaxAttempts="5" OnCooldownComplete="OnCooldownComplete" />
<HandyToast @ref="handyToast" Title="Success" Message="Your operation completed successfully."
    ToastType="HandyToastType.SUCCESS" Duration="5" />


@code {
    private HandyToast handyToast = default!;
    private NotificationModal notificationModal = default!;
    private CooldownTimer cooldownTimer = default!;
    private ProfileDTO dto = new();
    private bool isCurrentPasswordVisible = false;
    private string currentPasswordType => isCurrentPasswordVisible ? "text" : "password";
    private string currentPasswordIconClass => isCurrentPasswordVisible ? "fa-eye" : "fa-eye-slash";

    private bool isNewPasswordVisible = false;
    private string newPasswordType => isNewPasswordVisible ? "text" : "password";
    private string newPasswordIconClass => isNewPasswordVisible ? "fa-eye" : "fa-eye-slash";
    private bool loading = false;

    private string errMsg = "";

    private void OnCooldownComplete()
    {
        StateHasChanged();
    }

    private ClaimsPrincipal? user;

    protected override async Task OnInitializedAsync()
    {
        var authState = await ((ApiAuthenticationStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();
        user = authState.User;

        //Console.WriteLine(user.Claims.First(c => c.Type == ClaimTypes.Email).Value);

        dto = new() { 
            CurrentEmail = user.Claims.First(c => c.Type == ClaimTypes.Email).Value,
            Id = user.Claims.First(c => c.Type == ClaimTypes.NameIdentifier).Value,
        };
    }

    private void ToggleCurrentPasswordVisibility(MouseEventArgs mouseEventArgs)
    {
        if (mouseEventArgs != null)
        {
            isCurrentPasswordVisible = !isCurrentPasswordVisible;
        }
    }

    private void ToggleNewPasswordVisibility(MouseEventArgs mouseEventArgs)
    {
        if (mouseEventArgs != null)
        {
            isNewPasswordVisible = !isNewPasswordVisible;
        }
    }

    private async Task ToggleCurrentPasswordVisibility(KeyboardEventArgs e)
    {
        // Check if the pressed key is either "Space" or "Enter"
        if (e.Key == " " || e.Key == "Enter")
        {
            // Toggle the password visibility
            isCurrentPasswordVisible = !isCurrentPasswordVisible;
        }
    }

    private async Task ToggleNewPasswordVisibility(KeyboardEventArgs e)
    {
        // Check if the pressed key is either "Space" or "Enter"
        if (e.Key == " " || e.Key == "Enter")
        {
            // Toggle the password visibility
            isNewPasswordVisible = !isNewPasswordVisible;
        }
    }

    private async Task HandleSubmit()
    {
        if (cooldownTimer.IsCoolingDown)
        {
            errMsg = "";
            return;
        }

        loading = true;
        errMsg = ""; // Clear any previous error messages

        // Handle login logic here
        // Console.WriteLine("showing modal");
        var response = await accountService.EditProfileAsync(dto);
        loading = false;
        if (!response.Flag)
        {
            cooldownTimer.IncrementSubmissionCount();
            if (!cooldownTimer.IsCoolingDown)
            {
                errMsg = response.Message;
            }
            return;
        }

        // await notificationModal.ShowAsync("Success", response.Message, HandyModalType.SUCCESS);
        _ = handyToast.ShowToastAsync("Success", response.Message, HandyToastType.SUCCESS);
        dto = new() { 
            CurrentEmail = user.Claims.First(c => c.Type == ClaimTypes.Email).Value,
            Id = user.Claims.First(c => c.Type == ClaimTypes.NameIdentifier).Value,
        };

    }
    private async Task HandleErrors()
    {
        Console.WriteLine("error!");
    }
}
