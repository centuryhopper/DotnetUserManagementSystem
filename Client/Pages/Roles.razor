@page "/roles"
@using System.Text.Json
@using Client.Services
@using Radzen
@using Radzen.Blazor
@using static Shared.Models.ServiceResponses
@attribute [Authorize(Roles = Shared.Constants.ADMIN)]

<div class="text-center m-5">
    <h2><b>All Roles</b></h2>
</div>
<hr />
<div class="m-3">
    @if (doneLoadingLst)
    {
        <RadzenDataGrid @ref="grid" TItem="RoleDTO" Data="@roles" AllowPaging="true" PageSize="5" AllowSorting="true"
                        EditMode="DataGridEditMode.Single" RowCreate="@OnCreateRow" RowUpdate="@OnUpdateRow">
            <HeaderTemplate>
                <RadzenButton ButtonStyle="ButtonStyle.Success" Icon="add_circle" Text="Add New Role" Click="@InsertRow"
                              Disabled="@(roleToInsert != null || roleToUpdate != null)" />
            </HeaderTemplate>
            <Columns>
                @* Id is hidden, same as before. Add more columns here if RoleDTO has other fields. *@

                <RadzenDataGridColumn Property="@nameof(RoleDTO.RoleName)" Title="Role Name">
                    <EditTemplate Context="role">
                        <RadzenTextBox @bind-Value="role.RoleName" Style="width:100%" />
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn Property="@nameof(RoleDTO.IsActive)" Title="Active" TextAlign="TextAlign.Center"
                                      Width="120px">
                    <Template Context="role">
                        <RadzenCheckBox Value="@role.IsActive" Disabled="true" />
                    </Template>
                    <EditTemplate Context="role">
                        <RadzenCheckBox @bind-Value="role.IsActive" />
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn Title="Actions" Sortable="false" Filterable="false" TextAlign="TextAlign.Right"
                                      Width="140px">
                    <Template Context="role">
                        <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat"
                                      Size="ButtonSize.Medium" Click="@(() => EditRow(role))" @onclick:stopPropagation="true"
                                      Disabled="@(roleToInsert != null || roleToUpdate != null)" />
                        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat"
                                      Size="ButtonSize.Medium" Class="ms-1" Click="@(() => DeleteRow(role))"
                                      @onclick:stopPropagation="true" Disabled="@(roleToInsert != null || roleToUpdate != null)" />
                    </Template>
                    <EditTemplate Context="role">
                        <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat"
                                      Size="ButtonSize.Medium" Click="@(() => SaveRow(role))" />
                        <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat"
                                      Size="ButtonSize.Medium" Class="ms-1" Click="@(() => CancelEdit(role))" />
                    </EditTemplate>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
    else
    {
        <div class="d-flex justify-content-center">
            <div id="loadingIndicator" class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
</div>



@code {
    private bool doneLoadingLst = false;
    private HttpClient httpClient { get; set; } = default!;

    private RadzenDataGrid<RoleDTO> grid = default!;
    private List<RoleDTO> roles = [];

    private RoleDTO? roleToInsert;
    private RoleDTO? roleToUpdate;
    private RoleDTO? backup; // copy of the row being edited, restored on cancel/failure

    protected override async Task OnInitializedAsync()
    {
        httpClient = httpClientFactory.CreateClient(Constants.HTTP_CLIENT);
        await LoadRoles();
        doneLoadingLst = true;
    }

    private async Task LoadRoles()
    {
        roles = ((await httpClient.GetFromJsonAsync<List<RoleDTO>>("api/Roles/get-roles")) ?? [])
            .OrderBy(r => r.Id)
            .ToList();
    }

    // ---------- row actions ----------

    private async Task InsertRow()
    {
        roleToInsert = new RoleDTO { IsActive = true };
        await grid.InsertRow(roleToInsert);
    }

    private async Task EditRow(RoleDTO role)
    {
        backup = Clone(role);
        roleToUpdate = role;
        await grid.EditRow(role);
    }

    // Commits the edit; Radzen then fires RowCreate (new row) or RowUpdate (existing row).
    private async Task SaveRow(RoleDTO role) => await grid.UpdateRow(role);

    private async Task CancelEdit(RoleDTO role)
    {
        grid.CancelEditRow(role);

        if (role != roleToInsert && backup is not null)
        {
            var idx = roles.IndexOf(role);
            if (idx >= 0) roles[idx] = backup;
        }

        ResetEditState();
        await grid.Reload();
    }

    private async Task DeleteRow(RoleDTO role)
    {
        var response = await httpClient.DeleteAsync($"api/Roles/delete-role/{role.Id}");
        var responseContent = await response.Content.ReadFromJsonAsync<GeneralResponse>();

        if (responseContent is null || !responseContent.Flag)
        {
            await toastService.Error("Error", responseContent?.Message ?? "Delete failed.");
            return;
        }

        roles.Remove(role);
        await grid.Reload();
        await toastService.Success("Success", responseContent.Message);
    }

    // ---------- grid events ----------

    private async Task OnCreateRow(RoleDTO role)
    {
        // the API takes a list, so send a single-item list
        var response = await httpClient.PostAsJsonAsync("api/Roles/add-roles", new[] { role });
        var responseContents = (await response.Content.ReadFromJsonAsync<List<GeneralResponse>>()) ?? [];

        foreach (var rc in responseContents)
        {
            if (rc.Flag)
                await toastService.Success("Success", rc.Message);
            else
                await toastService.Error("Error", rc.Message);
        }

        // add-roles doesn't return the new Id, so reload from the server.
        // Otherwise the new row has Id = 0 and editing/deleting it would fail.
        ResetEditState();
        await LoadRoles();
        await grid.Reload();
    }

    private async Task OnUpdateRow(RoleDTO role)
    {
        var response = await httpClient.PatchAsJsonAsync("api/Roles/edit-role", role);
        var responseContent = await response.Content.ReadFromJsonAsync<GeneralResponse>();

        if (responseContent is null || !responseContent.Flag)
        {
            await toastService.Error("Error", responseContent?.Message ?? "Update failed.");

            // roll the row back to what it was before editing
            var idx = roles.IndexOf(role);
            if (idx >= 0 && backup is not null) roles[idx] = backup;
        }
        else
        {
            await toastService.Success("Success", responseContent.Message);
        }

        ResetEditState();
        await grid.Reload();
    }

    // ---------- helpers ----------

    private void ResetEditState()
    {
        roleToInsert = null;
        roleToUpdate = null;
        backup = null;
    }

    private static RoleDTO Clone(RoleDTO role) =>
        JsonConvert.DeserializeObject<RoleDTO>(JsonConvert.SerializeObject(role))!;
}